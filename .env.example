# PocketBase público; NEXT_PUBLIC_* queda incorporado durante `next build`.
NEXT_PUBLIC_POCKETBASE_URL=https://pb-lomaton.epixum.com

# URL usada exclusivamente por Route Handlers. Puede coincidir con la pública.
POCKETBASE_URL=https://pb-lomaton.epixum.com

# Cuenta técnica limitada de la colección `service_accounts`.
# Se crea una vez mediante el MCP de PocketBase y se configura también en Dokploy.
# Nunca uses aquí una cuenta de `_superusers`.
POCKETBASE_SERVICE_EMAIL=lomaton-server@example.invalid
POCKETBASE_SERVICE_PASSWORD=reemplazar-por-un-secreto-largo

# Límites defensivos de las importaciones.
IMPORT_MAX_BYTES=5242880
IMPORT_MAX_ROWS=5000

# PDF de alumno regular. PocketBase aplica además el tope estructural de 10 MiB.
LOMATON_CERTIFICATE_MAX_BYTES=10485760
