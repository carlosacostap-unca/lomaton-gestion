# PocketBase público; NEXT_PUBLIC_* queda incorporado durante `next build`.
NEXT_PUBLIC_POCKETBASE_URL=https://pb-lomaton.epixum.com

# URL usada exclusivamente por Route Handlers. Puede coincidir con la pública.
POCKETBASE_URL=https://pb-lomaton.epixum.com

# Lista separada por comas. No otorga permisos de superusuario de PocketBase.
ADMIN_EMAILS=carlosacostap@tecno.unca.edu.ar

# Límites defensivos de las importaciones.
IMPORT_MAX_BYTES=5242880
IMPORT_MAX_ROWS=5000
